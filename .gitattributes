# Preserve byte identities across checkouts even when core.autocrlf=true.
# Loader evidence also fingerprints these minimal offline-build inputs.
/Cargo.toml text eol=lf
/Cargo.lock text eol=lf
/README.md text eol=lf
/SOURCES.md text eol=lf
/src/*.rs text eol=lf
/src/data/*.rs text eol=lf
/tools/check_loader.py text eol=lf
/tools/check_queries.py text eol=lf
/tools/generate_query_case.py text eol=lf
/tools/generate_query_vectors.py text eol=lf
/tools/generate_category_vectors.py text eol=lf
/tests/*.rs text eol=lf
/docs/query-case.json text eol=lf
/docs/query-verification.json text eol=lf
/docs/category-verification.json text eol=lf
/third_party/unicode/LICENSE.txt -text
/data/*.bin binary
/data/*.json -text
/data/UPSTREAM-SOURCES.md -text
/src/data_meta.rs -text
/docs/reference-baseline.json -text
/tests/fixtures/python-api-v1.json -text
/LICENSE -text
